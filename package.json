{
  "name": "dumpus-app",
  "version": "1.0.11",
  "private": true,
  "license": "GPL-3.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "pnpm": "12.16.1"
  },
  "scripts": {
    "android:dev": "cross-env-shell NODE_ENV=development \"echo 'Run `pnpm dev:mobile` in parallel' && cap sync && cap run android\"",
    "android:dev:static": "cross-env-shell NODE_ENV=production \"echo 'Run `pnpm build:mobile first` && cap sync && cap run android\"",
    "build": "cross-env-shell NEXT_PUBLIC_DEPLOY_ENV=web \"pnpm build:shared\"",
    "build:desktop": "cross-env-shell NEXT_PUBLIC_DEPLOY_ENV=desktop \"pnpm build:shared\"",
    "build:mobile": "cross-env-shell NEXT_PUBLIC_DEPLOY_ENV=mobile \"pnpm build:shared\"",
    "build:shared": "pnpm script:list-locales && next build",
    "dev": "cross-env-shell NEXT_PUBLIC_DEPLOY_ENV=web \"pnpm dev:shared\"",
    "dev:desktop": "cross-env-shell NEXT_PUBLIC_DEPLOY_ENV=desktop \"pnpm dev:shared\"",
    "dev:mobile": "cross-env-shell NEXT_PUBLIC_DEPLOY_ENV=mobile \"pnpm dev:shared\"",
    "dev:shared": "pnpm script:list-locales && next dev",
    "dev:tauri": "tauri dev",
    "format": "prettier . -w",
    "ios:dev": "cross-env-shell NODE_ENV=development \"cap sync && cap run ios\"",
    "ios:dev:static": "cross-env-shell NODE_ENV=production \"cap sync && cap run ios\"",
    "lint": "pnpm script:list-locales && eslint src",
    "prepare": "pnpm script:list-locales",
    "release:patch": "node ./scripts/release.cjs patch",
    "release:minor": "node ./scripts/release.cjs minor",
    "release:major": "node ./scripts/release.cjs major",
    "script:build-android": "cross-env-shell NODE_ENV=production \"cap sync\" && node ./scripts/build-android.cjs",
    "script:flatten-dist": "node ./scripts/flatten-trailing-slash.cjs",
    "script:list-locales": "node ./scripts/list-locales.cjs",
    "start": "serve dist",
    "tauri:icon": "tauri icon ./ios/App/App/Assets.xcassets/AppIcon.appiconset/AppIcon-60@3x~car.png",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:docker": "sh ./scripts/e2e-docker.sh",
    "trapeze:run": "node ./trapeze.config.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^6.0.2",
    "@hugotomazi/capacitor-navigation-bar": "^4.0.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "capacitor-plugin-safe-area": "^5.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "cordova-plugin-purchase": "^13.20.0",
    "crc-32": "^1.2.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "flagpack-core": "^2.1.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "i18next-resources-to-backend": "^1.2.3",
    "lz-string": "^1.5.0",
    "mitt": "^3.0.1",
    "next": "16.4.3",
    "next-language-detector": "^1.1.1",
    "pako": "^3.0.3",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.1.9",
    "react-markdown": "^10.1.0",
    "react-medium-image-zoom": "^5.4.9",
    "react-use": "^17.6.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.15.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/cli": "^1.6.3",
    "@trapezedev/project": "^7.1.11",
    "@types/sql.js": "^1.4.11",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "node-fetch": "^3.3.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6"
  }
}
